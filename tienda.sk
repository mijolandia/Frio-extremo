                abrirMenuConfirmacionMercado(player, 50.00, {_b}, "Libro: Caída de Pluma II", "book_ff2", "{@title_cat3}")
            else if {_slot} is 30:
                set {_b} to enchanted book
                add feather falling 4 to enchantments of {_b}
                abrirMenuConfirmacionMercado(player, 110.00, {_b}, "Libro: Caída de Pluma IV", "book_ff4", "{@title_cat3}")
            else if {_slot} is 31:
                set {_b} to enchanted book
                add looting 1 to enchantments of {_b}
                abrirMenuConfirmacionMercado(player, 80.00, {_b}, "Libro: Saqueo I", "book_loot1", "{@title_cat3}")
            else if {_slot} is 32:
                set {_b} to enchanted book
                add looting 2 to enchantments of {_b}
                abrirMenuConfirmacionMercado(player, 150.00, {_b}, "Libro: Saqueo II", "book_loot2", "{@title_cat3}")
            else if {_slot} is 33:
                set {_b} to enchanted book
                add efficiency 4 to enchantments of {_b}
                abrirMenuConfirmacionMercado(player, 160.00, {_b}, "Libro: Eficiencia IV", "book_eff4", "{@title_cat3}")
            else if {_slot} is 34:
                set {_b} to enchanted book
                add mending 1 to enchantments of {_b}
                abrirMenuConfirmacionMercado(player, 450.00, {_b}, "Libro: Reparación I (Mending)", "book_mending", "{@title_cat3}")

        # --- CLICS EN CATEGORÍA 4 (NETHER & ALQUIMIA) ---
        else if {_name} is "{@title_cat4}":
            if {_slot} is 10:
                abrirMenuConfirmacionMercado(player, 8.00, 64 of netherrack, "Netherrack (x64)", "netherrack", "{@title_cat4}")
            else if {_slot} is 11:
                abrirMenuConfirmacionMercado(player, 25.00, 32 of quartz block, "Bloque de Cuarzo (x32)", "quartz_block", "{@title_cat4}")
            else if {_slot} is 12:
                abrirMenuConfirmacionMercado(player, 18.00, 32 of quartz, "Cuarzo del Nether (x32)", "quartz", "{@title_cat4}")
            else if {_slot} is 13:
                abrirMenuConfirmacionMercado(player, 20.00, 32 of soul sand, "Arena de Almas (x32)", "soul_sand", "{@title_cat4}")
            else if {_slot} is 14:
                abrirMenuConfirmacionMercado(player, 15.00, 32 of nether bricks, "Ladrillos del Nether (x32)", "nether_bricks", "{@title_cat4}")
            else if {_slot} is 15:
                abrirMenuConfirmacionMercado(player, 12.00, 32 of basalt, "Basalto (x32)", "basalt", "{@title_cat4}")
            else if {_slot} is 16:
                abrirMenuConfirmacionMercado(player, 14.00, 16 of glowstone, "Piedra Luminosa (x16)", "glowstone", "{@title_cat4}")
            else if {_slot} is 19:
                abrirMenuConfirmacionMercado(player, 45.00, 16 of gold ingot, "Lingotes de Oro (x16)", "gold_ingot", "{@title_cat4}")
            else if {_slot} is 20:
                abrirMenuConfirmacionMercado(player, 1200.00, 1 of ancient debris, "Escombro Ancestral (x1)", "ancient_debris", "{@title_cat4}")
            else if {_slot} is 21:
                abrirMenuConfirmacionMercado(player, 2500.00, 1 of netherite upgrade smithing template, "Plantilla de Mejora Netherite (x1)", "netherite_upgrade", "{@title_cat4}")
            else if {_slot} is 22:
                abrirMenuConfirmacionMercado(player, 30.00, 16 of obsidian, "Obsidiana (x16)", "obsidian", "{@title_cat4}")
            else if {_slot} is 23:
                abrirMenuConfirmacionMercado(player, 1500.00, 1 of nether star, "Estrella del Nether (x1)", "nether_star", "{@title_cat4}")
            else if {_slot} is 24:
                abrirMenuConfirmacionMercado(player, 45.00, 1 of wither skeleton skull, "Calavera de Wither Skeleton (x1)", "wither_skeleton_skull", "{@title_cat4}")
            else if {_slot} is 25:
                abrirMenuConfirmacionMercado(player, 50.00, 1 of brewing stand, "Soporte para Pociones (x1)", "brewing_stand", "{@title_cat4}")
            else if {_slot} is 28:
                abrirMenuConfirmacionMercado(player, 25.00, 16 of nether wart, "Verruga del Nether (x16)", "nether_wart", "{@title_cat4}")
            else if {_slot} is 29:
                abrirMenuConfirmacionMercado(player, 30.00, 8 of blaze powder, "Polvo de Blaze (x8)", "blaze_powder", "{@title_cat4}")
            else if {_slot} is 30:
                abrirMenuConfirmacionMercado(player, 35.00, 2 of ghast tear, "Lágrima de Ghast (x2)", "ghast_tear", "{@title_cat4}")
            else if {_slot} is 31:
                abrirMenuConfirmacionMercado(player, 30.00, 8 of magma cream, "Crema de Magma (x8)", "magma_cream", "{@title_cat4}")
            else if {_slot} is 32:
                abrirMenuConfirmacionMercado(player, 40.00, 2 of phantom membrane, "Membrana de Fantasma (x2)", "phantom_membrane", "{@title_cat4}")
            else if {_slot} is 33:
                abrirMenuConfirmacionMercado(player, 20.00, 4 of fermented spider eye, "Ojo de Araña Fermentado (x4)", "fermented_spider_eye", "{@title_cat4}")
            else if {_slot} is 34:
                abrirMenuConfirmacionMercado(player, 15.00, 8 of glistering melon slice, "Sandía Reluciente (x8)", "glistering_melon_slice", "{@title_cat4}")
            else if {_slot} is 37:
                abrirMenuConfirmacionMercado(player, 20.00, 8 of golden carrot, "Zanahoria Dorada (x8)", "golden_carrot", "{@title_cat4}")
            else if {_slot} is 38:
                abrirMenuConfirmacionMercado(player, 15.00, 4 of blaze rod, "Vara de Blaze (x4)", "blaze_rod", "{@title_cat4}")
            else if {_slot} is 39:
                abrirMenuConfirmacionMercado(player, 10.00, 16 of glass bottle, "Frascos de Cristal (x16)", "glass_bottle", "{@title_cat4}")

        # --- CLICS EN CATEGORÍA 5 (EL END) ---
        else if {_name} is "{@title_cat5}":
            if {_slot} is 10:
                abrirMenuConfirmacionMercado(player, 40.00, 64 of end stone, "Piedra del End (x64)", "end_stone", "{@title_cat5}")
            else if {_slot} is 11:
                abrirMenuConfirmacionMercado(player, 55.00, 32 of end stone bricks, "Ladrillos de Piedra del End (x32)", "end_stone_bricks", "{@title_cat5}")
            else if {_slot} is 12:
                abrirMenuConfirmacionMercado(player, 65.00, 32 of purpur block, "Bloque de Purpur (x32)", "purpur_block", "{@title_cat5}")
            else if {_slot} is 13:
                abrirMenuConfirmacionMercado(player, 85.00, 8 of end rod, "Vara del End (x8)", "end_rod", "{@title_cat5}")
            else if {_slot} is 14:
                abrirMenuConfirmacionMercado(player, 90.00, 4 of ender eye, "Ojo de Ender (x4)", "ender_eye", "{@title_cat5}")
            else if {_slot} is 19:
                abrirMenuConfirmacionMercado(player, 280.00, 2 of shulker shell, "Caparazones de Shulker (x2)", "shulker_shell_end", "{@title_cat5}")
            else if {_slot} is 20:
                abrirMenuConfirmacionMercado(player, 750.00, 1 of elytra, "Elytras de Ender Dragón (x1)", "elytra", "{@title_cat5}")
            else if {_slot} is 21:
                abrirMenuConfirmacionMercado(player, 200.00, 1 of ender chest, "Cofre del End (x1)", "ender_chest", "{@title_cat5}")
            else if {_slot} is 22:
                abrirMenuConfirmacionMercado(player, 140.00, 4 of dragon breath, "Aliento de Dragón (x4)", "dragon_breath", "{@title_cat5}")
            else if {_slot} is 23:
                abrirMenuConfirmacionMercado(player, 900.00, 1 of dragon head, "Cabeza de Dragón (x1)", "dragon_head", "{@title_cat5}")

        # --- MENÚ DE CONFIRMACIÓN ---
        else if {_name} is "{@title_confirm}":
            set {_uuid} to uuid of player
            set {_parent} to {-mshop::%{_uuid}%::parent}
            set {_q1} to {-mshop::%{_uuid}%::q1}
            set {_q2} to {-mshop::%{_uuid}%::q2}
            set {_q3} to {-mshop::%{_uuid}%::q3}
            
            if {_slot} is 10:
                procesarCompraMercado(player, {_q1})
            else if {_slot} is 11:
                procesarCompraMercado(player, {_q2})
            else if {_slot} is 12:
                procesarCompraMercado(player, {_q3})
            else if {_slot} is 14:
                procesarVentaMercado(player, {_q1})
            else if {_slot} is 15:
                procesarVentaMercado(player, {_q2})
            else if {_slot} is 16:
                procesarVentaMercado(player, {_q3})
            else if {_slot} is 22:
                play sound "{@sound_click}" with volume 0.7 and pitch 0.9 to player
                if {_parent} is "{@title_cat1}":
                    open chest inventory with 6 rows named "{@title_cat1}" to player
                    fillShopBorders(player, 6)
                    renderCat1GUI(player)
                else if {_parent} is "{@title_cat2}":
                    open chest inventory with 6 rows named "{@title_cat2}" to player
                    fillShopBorders(player, 6)
                    renderCat2GUI(player)
                else if {_parent} is "{@title_cat3}":
                    open chest inventory with 6 rows named "{@title_cat3}" to player
                    fillShopBorders(player, 6)
                    renderCat3GUI(player)
                else if {_parent} is "{@title_cat4}":
                    open chest inventory with 6 rows named "{@title_cat4}" to player
                    fillShopBorders(player, 6)
                    renderCat4GUI(player)
                else if {_parent} is "{@title_cat5}":
                    open chest inventory with 6 rows named "{@title_cat5}" to player
                    fillShopBorders(player, 6)
                    renderCat5GUI(player)
                else:
                    open chest inventory with 5 rows named "{@title_main}" to player
                    fillShopBorders(player, 5)
                    renderMainGUI(player)

on inventory close:
    if name of event-inventory is "{@title_confirm}":
        delete {-mshop::%uuid of player%::*}

# ==============================================================================
# 7. COMANDOS PRINCIPALES
# ==============================================================================
command /shop [<text>]:
    aliases: /tienda, /mercado, /comprar
    trigger:
        if arg-1 is "reload":
            if sender has permission "survival.shop.admin":
                execute console command "sk reload %script's name%"
                send "{@prefix}&a¡El mercado ha sido recargado correctamente!" to sender
                stop
            else:
                send "&cNo tienes permisos de administrador." to sender
                stop
                
        if sender is console:
            send "{@prefix}&cEste menú solo es para jugadores." to sender
            stop
            
        play sound "{@sound_open}" with volume 0.7 and pitch 1.0 to player
        open chest inventory with 5 rows named "{@title_main}" to player
        fillShopBorders(player, 5)
        renderMainGUI(player)

command /perfil:
    aliases: /stats, /tiendastats
    trigger:
        if sender is console:
            send "{@prefix}&cEste comando solo es para jugadores." to sender
            stop
            
        play sound "{@sound_open}" with volume 0.7 and pitch 1.2 to player
        open chest inventory with 3 rows named "{@title_profile}" to player
        fillShopBorders(player, 3)
        
        set {_spent_total} to {total_spent::%uuid of player%} ? 0
        set {_spent_cycle} to {market_spent::%name of player%} ? 0
        
        set {_rango} to "&7Comprador Novato"
        if {_spent_total} >= 10000:
            set {_rango} to "&6&lCOMPRADOR ELITE 🏆"
        else if {_spent_total} >= 2500:
            set {_rango} to "&eComprador Frecuente ⭐"
            
        set {_head} to skull of player
        set slot 11 of player's current inventory to {_head} named "&e&lTUS ESTADÍSTICAS" with lore "", "&7Jugador: &f%player's name%", "&7Rango Comercial: %{_rango}%", "", "&7• Gastado este ciclo (5h): &a$%cleanMoney({_spent_cycle})%", "&7• Total histórico gastado: &e$%cleanMoney({_spent_total})%" and "&8(Tus datos solo los ves tú)"
        
        set {_top1_name} to "Nadie"
        set {_top1_amount} to 0
        loop {market_spent::*}:
            if loop-value > {_top1_amount}:
                set {_top1_amount} to loop-value
                set {_top1_name} to loop-index
                
        set slot 13 of player's current inventory to nether star named "&b&lESTADO DEL MERCADO" with lore "", "&7Líder del ciclo actual:", "&6&l#1 &f%{_top1_name}% &7- &a$%cleanMoney({_top1_amount})%", "", "&7• Reinicio de oferta/demanda: &eCada 5 horas" and "&7• Estado del Mercado: &a&lACTIVO"
        
        set slot 15 of player's current inventory to book named "&d&lRECOMPENSAS Y LOGROS" with lore "", "&7Aumenta tu total gastado para", "&7desbloquear rangos en el chat:", "", "&7[Novato] &8-> &7$0", "&e[Frecuente] &8-> &7$2,500" and "&6[ELITE] &8-> &7$10,000"