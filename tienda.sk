# ==============================================================================
# 6. EVENTO PRINCIPAL DE CLICS
# ==============================================================================
on inventory click:
    set {_name} to name of event-inventory
    if {_name} is "{@title_main}" or "{@title_cat1}" or "{@title_cat2}" or "{@title_cat3}" or "{@title_cat4}" or "{@title_cat5}" or "{@title_confirm}" or "{@title_profile}":
        cancel event
        if clicked slot is empty:
            stop
            
        set {_slot} to index of event-slot
        
        # --- MENÚ PRINCIPAL ---
        if {_name} is "{@title_main}":
            if {_slot} is 19:
                play sound "{@sound_click}" with volume 0.7 and pitch 1.1 to player
                open chest inventory with 6 rows named "{@title_cat1}" to player
                fillShopBorders(player, 6)
                renderCat1GUI(player)
            else if {_slot} is 20:
                play sound "{@sound_click}" with volume 0.7 and pitch 1.1 to player
                open chest inventory with 6 rows named "{@title_cat2}" to player
                fillShopBorders(player, 6)
                renderCat2GUI(player)
            else if {_slot} is 21:
                play sound "{@sound_click}" with volume 0.7 and pitch 1.1 to player
                open chest inventory with 6 rows named "{@title_cat3}" to player
                fillShopBorders(player, 6)
                renderCat3GUI(player)
            else if {_slot} is 22:
                play sound "{@sound_click}" with volume 0.7 and pitch 1.1 to player
                open chest inventory with 6 rows named "{@title_cat4}" to player
                fillShopBorders(player, 6)
                renderCat4GUI(player)
            else if {_slot} is 23:
                play sound "{@sound_click}" with volume 0.7 and pitch 1.1 to player
                open chest inventory with 6 rows named "{@title_cat5}" to player
                fillShopBorders(player, 6)
                renderCat5GUI(player)
            else if {_slot} is 25:
                play sound "{@sound_click}" with volume 0.7 and pitch 1.2 to player
                execute player command "pshop"
            else if {_slot} is 40:
                play sound "{@sound_click}" with volume 0.7 and pitch 1.2 to player
                execute player command "perfil"

        # --- BOTONES DE ATRÁS EN CATEGORÍAS ---
        else if {_name} is "{@title_cat1}" or "{@title_cat2}" or "{@title_cat3}" or "{@title_cat4}" or "{@title_cat5}":
            if {_slot} is 49:
                play sound "{@sound_click}" with volume 0.7 and pitch 0.9 to player
                open chest inventory with 5 rows named "{@title_main}" to player
                fillShopBorders(player, 5)
                renderMainGUI(player)
                stop

        # --- CLICS EN CATEGORÍA 1 ---
        if {_name} is "{@title_cat1}":
            if {_slot} is 10:
                abrirMenuConfirmacionMercado(player, 6.00, 8 of bread, "Pan Reforzado (x8)", "bread", "{@title_cat1}")
