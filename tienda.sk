# ==============================================================================
#  🌿 NATURELAND | MERCADO SURVIVAL DINÁMICO (PAPER 1.21+ / SKRIPT 2.15.4)
# ==============================================================================

options:
    prefix: &8[&a&lNATURE&e&lLAND&8] &r
    
    # --- TÍTULOS DE INTERFAZ ---
    title_main: &8🌿 &a&lNATURE&e&lLAND &8| &7Mercado
    title_cat1: &8🌿 &a&lMERCADO &8| &eSuministros
    title_cat2: &8🌿 &a&lMERCADO &8| &bUtilidades
    title_cat3: &8🌿 &a&lMERCADO &8| &dEncantos
    title_cat4: &8🌿 &a&lMERCADO &8| &cNether y Alquimia
    title_cat5: &8🌿 &a&lMERCADO &8| &5Dimensión End
    title_confirm: &8🌿 &a&lTRANSACCIÓN &8| &0&lCANTIDAD
    title_profile: &8🌿 &a&lMERCADO &8| &eEstadísticas

    # --- SONIDOS ---
    sound_success: entity.player.levelup
    sound_error: block.note_block.bass
    sound_click: ui.button.click
    sound_open: block.chest.open

# ==============================================================================
# 1. LIMPIEZA DE VARIABLES TEMPORALES EN MEMORIA
# ==============================================================================
on unload:
    delete {-shop_cooldown::*}
    delete {-mshop::*}

# ==============================================================================
# 2. CICLO ECONÓMICO: REINICIO Y TOP 3 GASTADORES (CADA 5 HORAS)
# ==============================================================================
every 5 hours:
    broadcast ""
    broadcast "{@prefix}&e&l🏆 TOP 3 GASTADORES DEL MERCADO NATURELAND 🏆"
    broadcast "&7(Ciclo de las últimas 5 horas)"
    broadcast ""
    
    set {_count} to 1
    loop {market_spent::*}:
        set {_high_spent::%loop-index%} to loop-value
        
    loop 3 times:
        set {_max} to 0
        set {_top_player} to "Nadie"
        loop {_high_spent::*}:
            if loop-value-2 > {_max}:
                set {_max} to loop-value-2
                set {_top_player} to loop-index
        if {_max} > 0:
            broadcast "&6&l#%{_count}% &f%{_top_player}% &7- Gastó: &a$%cleanMoney({_max})%"
            delete {_high_spent::%{_top_player}%}
            add 1 to {_count}
        else if {_count} is 1:
            broadcast "&7¡Nadie ha gastado dinero en este ciclo aún!"
            exit loop
            
    broadcast ""
    broadcast "{@prefix}&a&l¡EL MERCADO SE HA REINICIADO!"
    broadcast "&7Todos los precios de oferta y demanda han vuelto a su valor normal."
    broadcast ""
    
    delete {market_spent::*}
    delete {market_demand::*}

# ==============================================================================
# 3. FUNCIONES DE ECONOMÍA Y FORMATO
# ==============================================================================
function cleanMoney(n: number) returns text:
    return "%{_n}%"

function getDynamicPrice(base: number, id: text, type: text) returns number:
    if {market_demand::%{_id}%} is not set:
        set {market_demand::%{_id}%} to 0
        
    set {_multiplier} to 1 + ({market_demand::%{_id}%} * 0.02)
    
    if {_multiplier} > 2.0:
        set {_multiplier} to 2.0
    else if {_multiplier} < 0.5:
        set {_multiplier} to 0.5
        
    set {_finalPrice} to {_base} * {_multiplier}
    
    if {_type} is "sell":
        set {_finalPrice} to {_finalPrice} * 0.40
        
    return {_finalPrice}

# --- DEGRADADO VISUAL DE BORDES NATURELAND ---
function fillShopBorders(p: player, rows: number):
    set {_totalSlots} to ({_rows} * 9) - 1
    
    set {_panes::1} to lime stained glass pane named "&r"
    set {_panes::2} to green stained glass pane named "&r"
    set {_panes::3} to yellow stained glass pane named "&r"
    set {_panes::4} to orange stained glass pane named "&r"
    
    set {_color_idx} to 1
    loop {_totalSlots} + 1 times:
        set {_slot} to loop-number - 1
        set {_is_border} to false
        
        if {_slot} < 9:
            set {_is_border} to true
        else if {_slot} >= ({_totalSlots} - 8):
            set {_is_border} to true
        else if mod({_slot}, 9) is 0:
            set {_is_border} to true
        else if mod(({_slot} + 1), 9) is 0:
            set {_is_border} to true
            
        if {_is_border} is true:
            set slot {_slot} of {_p}'s current inventory to {_panes::%{_color_idx}%}
            add 1 to {_color_idx}
            if {_color_idx} > 4:
                set {_color_idx} to 1

function setShopItem(p: player, slot: number, base: number, id: text, item: item, name: text):
    set {_pBuy} to getDynamicPrice({_base}, {_id}, "buy")
    set {_pSell} to getDynamicPrice({_base}, {_id}, "sell")
    set slot {_slot} of {_p}'s current inventory to {_item} named "%{_name}%" with lore "&aCompra: &f$%cleanMoney({_pBuy})%", "&cVenta: &f$%cleanMoney({_pSell})%", "" and "&e▶ Clic para elegir cantidad / comprar"

# ==============================================================================
# 4. SISTEMA DE CONFIRMACIÓN Y SELECCIÓN DE CANTIDAD INTELIGENTE
# ==============================================================================
function abrirMenuConfirmacionMercado(p: player, basePrice: number, baseItem: item, label: text, id: text, parent_gui: text):
    set {_uuid} to uuid of {_p}
    set {-mshop::%{_uuid}%::price} to {_basePrice}
    set {-mshop::%{_uuid}%::item} to {_baseItem}
    set {-mshop::%{_uuid}%::label} to {_label}
    set {-mshop::%{_uuid}%::id} to {_id}
    set {-mshop::%{_uuid}%::parent} to {_parent_gui}
    
    set {_base_amt} to item amount of {_baseItem}
    if {_base_amt} < 1:
        set {_base_amt} to 1
        
    set {_unit_price} to {_basePrice} / {_base_amt}
    set {-mshop::%{_uuid}%::unit_price} to {_unit_price}
    
    # Elección lógica de botones según la cantidad base en tienda:
    if {_base_amt} >= 16:
        set {_q1} to 16
        set {_q2} to 32
        set {_q3} to 64
    else if {_base_amt} >= 8:
        set {_q1} to 8
        set {_q2} to 32
        set {_q3} to 64
    else if {_base_amt} >= 4:
        set {_q1} to 4
        set {_q2} to 16
        set {_q3} to 64
    else if {_base_amt} >= 2:
        set {_q1} to 2
        set {_q2} to 16
        set {_q3} to 64
    else:
        set {_q1} to 1
        set {_q2} to 16
        set {_q3} to 64
        
    set {-mshop::%{_uuid}%::q1} to {_q1}
    set {-mshop::%{_uuid}%::q2} to {_q2}
    set {-mshop::%{_uuid}%::q3} to {_q3}
    
    set {_gui} to a new chest inventory with 3 rows named "{@title_confirm}"
    open {_gui} to {_p}
    actualizarConfirmacionGUI({_p})

function actualizarConfirmacionGUI(p: player):
    set {_uuid} to uuid of {_p}
    set {_basePrice} to {-mshop::%{_uuid}%::price}
    set {_baseItem} to {-mshop::%{_uuid}%::item}
    set {_label} to {-mshop::%{_uuid}%::label}
    set {_id} to {-mshop::%{_uuid}%::id}
    set {_unit_price} to {-mshop::%{_uuid}%::unit_price}
    set {_q1} to {-mshop::%{_uuid}%::q1}
    set {_q2} to {-mshop::%{_uuid}%::q2}
    set {_q3} to {-mshop::%{_uuid}%::q3}
    
    if {_basePrice} is not set:
        stop
        
    loop integers between 0 and 26:
        set slot loop-value of {_p}'s current inventory to black stained glass pane named " "
        
    set {_unit_buy} to getDynamicPrice({_unit_price}, {_id}, "buy")
    set {_unit_sell} to getDynamicPrice({_unit_price}, {_id}, "sell")
    
    set {_cost_buy1} to {_unit_buy} * {_q1}
    set {_cost_buy2} to {_unit_buy} * {_q2}
    set {_cost_buy3} to {_unit_buy} * {_q3}
    
    set {_cost_sell1} to {_unit_sell} * {_q1}
    set {_cost_sell2} to {_unit_sell} * {_q2}
    set {_cost_sell3} to {_unit_sell} * {_q3}
    
    set {_item_type} to type of {_baseItem}
    set {_has_qty} to number of {_item_type} in {_p}'s inventory
    
    # Previsualización Central
    set slot 13 of {_p}'s current inventory to {_baseItem} named "%{_label}%" with lore "", "&7Precio Unitario Compra: &a$%cleanMoney({_unit_buy})%", "&7Precio Unitario Venta: &c$%cleanMoney({_unit_sell})%", "", "&7Tu Saldo: &a$%cleanMoney({_p}'s balance)%", "&7En tu inventario: &f%{_has_qty}% objetos", "" and "&eSelecciona una opción a los lados"
    
    # Botones de Compra (Izquierda)
    set slot 10 of {_p}'s current inventory to lime stained glass pane named "&a&lCOMPRAR x%{_q1}%" with lore "", "&7Unidades: &f%{_q1}% objetos", "&7Precio Total: &a$%cleanMoney({_cost_buy1})%", "" and "&e▶ Clic para confirmar compra"
    set slot 11 of {_p}'s current inventory to lime stained glass pane named "&a&lCOMPRAR x%{_q2}%" with lore "", "&7Unidades: &f%{_q2}% objetos", "&7Precio Total: &a$%cleanMoney({_cost_buy2})%", "" and "&e▶ Clic para confirmar compra"
    set slot 12 of {_p}'s current inventory to lime stained glass pane named "&a&lCOMPRAR x%{_q3}% &7(MAX/STACK)" with lore "", "&7Unidades: &f%{_q3}% objetos (1 Stack)", "&7Precio Total: &a$%cleanMoney({_cost_buy3})%", "" and "&e▶ Clic para comprar stack completo"
    
    # Botones de Venta (Derecha)
    set slot 14 of {_p}'s current inventory to red stained glass pane named "&c&lVENDER x%{_q1}%" with lore "", "&7Unidades: &f%{_q1}% objetos", "&7Ganancia Total: &a$%cleanMoney({_cost_sell1})%", "" and "&6▶ Clic para confirmar venta"
    set slot 15 of {_p}'s current inventory to red stained glass pane named "&c&lVENDER x%{_q2}%" with lore "", "&7Unidades: &f%{_q2}% objetos", "&7Ganancia Total: &a$%cleanMoney({_cost_sell2})%", "" and "&6▶ Clic para confirmar venta"
    set slot 16 of {_p}'s current inventory to red stained glass pane named "&c&lVENDER x%{_q3}% &7(MAX/STACK)" with lore "", "&7Unidades: &f%{_q3}% objetos (1 Stack)", "&7Ganancia Total: &a$%cleanMoney({_cost_sell3})%", "" and "&6▶ Clic para vender stack completo"
    
    # Botón Volver
    set slot 22 of {_p}'s current inventory to barrier named "&c&l✖ VOLVER ATRÁS" with lore "" and "&7Clic para regresar a la categoría."

function procesarCompraMercado(p: player, quantity: number):
    set {_uuid} to uuid of {_p}
    set {_unit_price} to {-mshop::%{_uuid}%::unit_price}
    set {_baseItem} to {-mshop::%{_uuid}%::item}
    set {_label} to {-mshop::%{_uuid}%::label}
    set {_id} to {-mshop::%{_uuid}%::id}
    
    if {_unit_price} is not set:
        stop
        
    set {_unitCost} to getDynamicPrice({_unit_price}, {_id}, "buy")
    set {_totalCost} to {_unitCost} * {_quantity}
    set {_item_type} to type of {_baseItem}
    
    if {_p}'s balance < {_totalCost}:
        set {_missing} to {_totalCost} - {_p}'s balance
        send "{@prefix}&cFondos insuficientes. Te faltan &e$%cleanMoney({_missing})%&c." to {_p}
        play sound "{@sound_error}" with volume 0.8 and pitch 0.6 to {_p}
        stop
        
    if {_p} can't hold {_quantity} of {_item_type}:
        send "{@prefix}&cNo tienes espacio suficiente en tu inventario para &f%{_quantity}% &cobjetos." to {_p}
        play sound "{@sound_error}" with volume 0.8 and pitch 0.8 to {_p}
        stop
        
    remove {_totalCost} from {_p}'s balance
    
    set {_give_item} to {_baseItem}
    set item amount of {_give_item} to {_quantity}
    give {_give_item} to {_p}
        
    add 1 to {market_demand::%{_id}%}
    add {_totalCost} to {market_spent::%name of {_p}%}
    add {_totalCost} to {total_spent::%uuid of {_p}%}
    
    send "{@prefix}&aHas comprado &f%{_label}% &7(x%{_quantity}%) &apor &e$%cleanMoney({_totalCost})%&a." to {_p}
    play sound "{@sound_success}" with volume 0.6 and pitch 1.2 to {_p}
    actualizarConfirmacionGUI({_p})

function procesarVentaMercado(p: player, quantity: number):
    set {_uuid} to uuid of {_p}
    set {_unit_price} to {-mshop::%{_uuid}%::unit_price}
    set {_baseItem} to {-mshop::%{_uuid}%::item}
    set {_label} to {-mshop::%{_uuid}%::label}
    set {_id} to {-mshop::%{_uuid}%::id}
    
    if {_unit_price} is not set:
        stop
        
    set {_unitEarnings} to getDynamicPrice({_unit_price}, {_id}, "sell")
    set {_totalEarnings} to {_unitEarnings} * {_quantity}
    set {_item_type} to type of {_baseItem}
    
    set {_has_amount} to number of {_item_type} in {_p}'s inventory
    if {_has_amount} < {_quantity}:
        send "{@prefix}&cNo tienes suficientes objetos en tu inventario. Necesitas &f%{_quantity}% &cy tienes &f%{_has_amount}%&c." to {_p}
        play sound "{@sound_error}" with volume 0.8 and pitch 0.6 to {_p}
        stop
        
    set {_remove_item} to {_baseItem}
    set item amount of {_remove_item} to {_quantity}
    remove {_remove_item} from {_p}'s inventory
        
    add {_totalEarnings} to {_p}'s balance
    remove 1 from {market_demand::%{_id}%}
    
    send "{@prefix}&aVendiste &f%{_label}% &7(x%{_quantity}%) &apor &e$%cleanMoney({_totalEarnings})%&a." to {_p}
    play sound "entity.experience_orb.pickup" with volume 0.7 and pitch 1.1 to {_p}
    actualizarConfirmacionGUI({_p})

# ==============================================================================
# 5. MENÚ PRINCIPAL Y CATEGORÍAS
# ==============================================================================
function renderMainGUI(p: player):
    if {total_spent::%uuid of {_p}%} is not set:
        set {total_spent::%uuid of {_p}%} to 0

    set {_head} to skull of {_p}
    set slot 4 of {_p}'s current inventory to {_head} named "&6&lTU CUENTA NATURELAND" with lore "", "&7Jugador: &f%{_p}'s name%", "&7Saldo Actual: &a$%cleanMoney({_p}'s balance)%", "&7Total Gastado: &e$%cleanMoney({total_spent::%uuid of {_p}%})%", "", "&e&lMECÁNICA ECONÓMICA:", "&7• Precios suben al comprar (Demanda)", "&7• Precios bajan al vender (Oferta)" and "&7• Clic en ítem: Abrir menú de cantidad (hasta 64)"
    
    set slot 19 of {_p}'s current inventory to bread named "&e&l1. SUMINISTROS Y COMIDA" with lore "", "&7Alimentos cocinados, cultivos básicos,", "&7maderas primarias y herramientas sencillas." and "&a&l▶ CLIC PARA EXPLORAR"
    set slot 20 of {_p}'s current inventory to beacon named "&b&l2. UTILIDADES Y BLOQUES" with lore "", "&7Herramientas de expedición, redstone básico,", "&7almacenamiento, hornos y artículos de utilidad." and "&a&l▶ CLIC PARA EXPLORAR"
    set slot 21 of {_p}'s current inventory to enchanted book named "&d&l3. LIBROS ENCANTADOS" with lore "", "&7Libros encantados individuales de nivel", "&7equilibrado para herramientas y armaduras." and "&a&l▶ CLIC PARA EXPLORAR"
    set slot 22 of {_p}'s current inventory to netherrack named "&c&l4. NETHER Y ALQUIMIA" with lore "", "&7Bloques, plantillas, oro, escombros, reactivos", "&epara faros, cristales y pociones preparadas." and "&a&l▶ CLIC PARA EXPLORAR"
    set slot 23 of {_p}'s current inventory to end stone named "&5&l5. DIMENSIÓN DEL END" with lore "", "&7Materiales raros del End, shulkers, elytras", "&7y objetos de muy alto valor económico." and "&a&l▶ CLIC PARA EXPLORAR"
    set slot 25 of {_p}'s current inventory to coal ore named "&6&lTIENDA DE PROTECCIONES" with lore "", "&7Abre directamente el menú de piedras", "&7de protección para asegurar terrenos." and "&a&l▶ CLIC PARA ENTRAR A /PSHOP"
    set slot 40 of {_p}'s current inventory to nether star named "&e&l⭐ MI PERFIL Y ESTADÍSTICAS ⭐" with lore "", "&7Consulta tus datos personales, rango comercial,", "&7y el líder del Top Gastadores en vivo." and "&a&l▶ CLIC PARA VER TUS STATS (/perfil)"

