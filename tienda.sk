    set {_b2} to enchanted book
    add efficiency 2 to enchantments of {_b2}
    setShopItem({_p}, 11, 55.00, "book_eff2", {_b2}, "&dLibro: Eficiencia II")
    
    set {_b3} to enchanted book
    add efficiency 3 to enchantments of {_b3}
