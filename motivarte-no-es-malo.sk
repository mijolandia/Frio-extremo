# =====================================================================
#
#              SISTEMA DE MOTIVACIÓN: EL PALO MÁGICO RGB
#    Descripción: Da palos motivacionales con funciones Premium.
#    Versión: 9.9.1 (Mojang Anti-Bug & Anti-Exploit Edition)
#
# =====================================================================

# ---------------------------------------------------------------------
# SISTEMA ANTI-DUPE INVISIBLE: CRÉDITOS DE CRAFTEO
# ---------------------------------------------------------------------
on craft:
    set {_tipo} to "%type of event-item%"
    if {_tipo} contains "chest" or "barrel" or "shulker" or "dispenser" or "dropper" or "hopper" or "furnace" or "smoker":
        add item amount of event-item to {motivacion::crafteados::%uuid of player%}

on place:
    set {_tipo} to "%type of event-block%"
    if {_tipo} contains "chest" or "barrel" or "shulker" or "dispenser" or "dropper" or "hopper" or "furnace" or "smoker":
        if player's gamemode is creative:
            set {motivacion::ignorar::%location of event-block%} to true  # FIX MC-105: Bloqueado exploit en creativo
            stop
            
        set {_u} to uuid of player
        if {motivacion::crafteados::%{_u}%} > 0:
            subtract 1 from {motivacion::crafteados::%{_u}%}
        else:
            set {motivacion::ignorar::%location of event-block%} to true

on break:
    set {_tipo} to "%type of event-block%"
    if {_tipo} contains "chest" or "barrel" or "shulker" or "dispenser" or "dropper" or "hopper" or "furnace" or "smoker":
        delete {motivacion::ignorar::%location of event-block%}
        delete {motivacion::cofres::%location of event-block%}

# ---------------------------------------------------------------------
# GENERADOR INTERNO DE LOS 10 RANGOS
# ---------------------------------------------------------------------
function getPaloMotivacional(forcedTier: integer) :: item:
    set {_frases::1} to "¡Tú puedes con todo, no te rindas!"
    set {_frases::2} to "Hoy es un excelente día para encontrar diamantes."
    set {_frases::3} to "Recuerda tomar agua y estirar la espalda."
    set {_frases::4} to "Cada bloque que picas te acerca a la grandeza."
    set {_frases::5} to "Eres más fuerte que un Creeper cargado."
    set {_frases::6} to "Si te caes a la lava, levántate con más fuerza."
    set {_frases::7} to "Tu creatividad no tiene límites en este mundo."
    set {_frases::8} to "Incluso en la capa -60 hay luz si sabes buscarla."
    set {_frases::9} to "Roma no se construyó en un día, tu base tampoco."
    set {_frases::10} to "¡Eres increíble, sigue así!"
    set {_frase} to a random element out of {_frases::*}

    set {_t} to {_forcedTier}
    if {_t} is 0:
        set {_roll} to a random integer between 1 and 1000
        if {_roll} <= 400:
            set {_t} to 1
        else if {_roll} <= 650:
            set {_t} to 2
        else if {_roll} <= 800:
            set {_t} to 3
        else if {_roll} <= 880:
            set {_t} to 4
        else if {_roll} <= 930:
            set {_t} to 5
        else if {_roll} <= 960:
            set {_t} to 6
        else if {_roll} <= 980:
            set {_t} to 7
        else if {_roll} <= 990:
            set {_t} to 8
        else if {_roll} <= 997:
            set {_t} to 9
        else:
            set {_t} to 10
    
    if {_t} is 1:
        set {_tag} to "&7&l[COMÚN]"
        set {_nom} to "&7Palo de la Constancia"
        set {_utilidad} to "&8▶ &7Click derecho: &fVelocidad I &7(15s)"
    else if {_t} is 2:
        set {_tag} to "&a&l[POCO COMÚN]"
        set {_nom} to "&aPalo del Esfuerzo"
        set {_utilidad} to "&8▶ &7Click derecho: &fPrisa Minera I &7(20s)"
    else if {_t} is 3:
        set {_tag} to "&9&l[RARO]"
        set {_nom} to "&9Palo de la Visión"
        set {_utilidad} to "&8▶ &7Click derecho: &fVisión Nocturna &7(2m)"
    else if {_t} is 4:
        set {_tag} to "<##A020F0>&l[ÉPICO]"
        set {_nom} to "<##D8BFD8>Palo del Sustento Vital"
        set {_utilidad} to "&8▶ &7Click derecho: &fSatura tu hambre al 100%%"
    else if {_t} is 5:
        set {_tag} to "&6&l[LEGENDARIO]"
        set {_nom} to "&ePalo del Fénix Inmortal"
        set {_utilidad} to "&8▶ &7Click derecho: &fResistencia al Fuego &7(45s)"
    else if {_t} is 6:
        set {_tag} to "<##8B0000>&l[ANCESTRAL]"
        set {_nom} to "<##FF4500>Bastón del Guerrero Antiguo"
        set {_utilidad} to "&8▶ &7Click derecho: &fFuerza I &7(15s)"
    else if {_t} is 7:
        set {_tag} to "<##00FFFF>&l[DIVINO]"
        set {_nom} to "<##E0FFFF>Reliquia del Olimpo"
        set {_utilidad} to "&8▶ &7Click derecho: &fCura estados + Corazones"
    else if {_t} is 8:
        set {_tag} to "<##FF0055>&l[M<##FF00AA>&lí<##FF00FF>&lt<##AA00FF>&li<##5500FF>&lc<##0000FF>&lo]"
        set {_nom} to "<##FF0055>✦ <##FFAA00>Palo <##00FF00>Cósmico <##00FFFF>RGB <##FF0055>✦"
        set {_utilidad} to "&8▶ &7Click derecho: &fRegeneración II &7(8s) + Show"
    else if {_t} is 9:
        set {_tag} to "<##33004D>&l[A<##4D0066>&lb<##660080>&li<##800099>&ls<##9900B3>&la<##B300CC>&ll]"
        set {_nom} to "<##33004D>⚡ Vara de las Profundidades ⚡"
        set {_utilidad} to "&8▶ &7Click derecho: &fBendición de Océano &7(1m)"
    else if {_t} is 10:
        set {_tag} to "<##00FFFF>&l[C<##33FFFF>&le<##66FFFF>&ll<##99FFFF>&le<##CCFFFF>&ls<##FFFFFF>&lt<##FFCCFF>&li<##FFAAFF>&la<##FF77FF>&ll]"
        set {_nom} to "<##00FFFF>⭐ <##FFFFFF>&lSoberanía del Universo <##00FFFF>⭐"
        set {_utilidad} to "&8▶ &7Click derecho: &fHéroe de la Aldea &7(3m)"

    set {_palo} to stick named {_nom}
    enchant {_palo} with unbreaking 1
    add hide enchants to item flags of {_palo}
    set line 1 of lore of {_palo} to {_tag}
    set line 2 of lore of {_palo} to ""
    set line 3 of lore of {_palo} to "&f&o""%{_frase}%"""
    set line 4 of lore of {_palo} to ""
    set line 5 of lore of {_palo} to {_utilidad}
    set line 6 of lore of {_palo} to ""
    set line 7 of lore of {_palo} to "&c&l❤ &cLigado a tu mente"
    return {_palo}

# ---------------------------------------------------------------------
# RECOMPENSA DE RECOLECCIÓN Y ANUNCIOS PREMIUM CON TELLRAW 
# ---------------------------------------------------------------------
function evaluarYAnunciarPalo(p: player, i: item):
    set {_nombre} to name of {_i}
    set {_lore1} to uncolored line 1 of lore of {_i}  # DEUDA TÉCNICA SALDADA: Texto plano sin colores
    set {_pName} to name of {_p}
    
    if {_lore1} contains "DIVINO":
        execute console command "tellraw @a [{""text"":""\n§b§l⚡ ¡SUERTE DIVINA! §7El jugador §f%{_pName}% §7ha descubierto una ""},{""text"":""§b§lReliquia del Olimpo"",""hoverEvent"":{""action"":""show_text"",""contents"":[""§b§lRango Oculto VII\n§7¡Invocó el poder de los dioses!""]}},{""text"":""§7 en un contenedor.\n""}]"
        play sound "ui.toast.challenge_complete" with volume 0.6 to all players
    else if {_lore1} contains "MÍTICO":
        execute console command "tellraw @a [{""text"":""\n§d§l🔮 ¡SUERTE MÍTICA! §7El jugador §f%{_pName}% §7ha desatado el ""},{""text"":""§d§l✦ Palo Cósmico RGB ✦"",""hoverEvent"":{""action"":""show_text"",""contents"":[""§d§lRango Oculto VIII\n§7El chat brilla ante tanta facha.""]}},{""text"":""§7.\n""}]"
        play sound "ui.toast.challenge_complete" with volume 0.6 to all players
    else if {_lore1} contains "ABISAL":
        execute console command "tellraw @a [{""text"":""\n§5§l⚡ ¡SUERTE ABISAL! §7El jugador §f%{_pName}% §7ha extraído la ""},{""text"":""§5§l⚡ Vara de las Profundidades ⚡"",""hoverEvent"":{""action"":""show_text"",""contents"":[""§5§lRango Oculto IX\n§7Las profundidades del océano tiemblan.""]}},{""text"":""§7 del vacío.\n""}]"
        play sound "ui.toast.challenge_complete" with volume 0.6 to all players
    else if {_lore1} contains "CELESTIAL":
        execute console command "tellraw @a [{""text"":""\n§e§l⭐ ¡SUERTE CELESTIAL! §7¡El universo aclama a §f%{_pName}%§7! Obtuvo la ""},{""text"":""§b§l⭐ §f§lSoberanía del Universo §b§l⭐"",""hoverEvent"":{""action"":""show_text"",""contents"":[""§e§lRango Máximo X (0.3%%)\n§7¡Tiene el poder absoluto en sus manos!""]}},{""text"":""§7.\n""}]"
        play sound "entity.ender_dragon.growl" with volume 0.5 and pitch 1.2 to all players

# ---------------------------------------------------------------------
# EFECTO ACTIONBAR AL TENERLO EN LA MANO
# ---------------------------------------------------------------------
every 1 second:
    loop all players:
        set {_nombre} to uncolored name of loop-player's tool
        if {_nombre} contains "Palo" or "Bastón" or "Reliquia" or "Soberanía" or "Vara":
            set {_frase} to line 3 of lore of loop-player's tool
            if {_frase} is set:
                send action bar "&e✨ Motivación: %{_frase}%" to loop-player

# ---------------------------------------------------------------------
# GUÍA PÚBLICA DE RANGOS (`/palos`)
# ---------------------------------------------------------------------
command /palos:
    description: Muestra la guía de rarezas de los palos mágicos.
    trigger:
        set {_u} to a new chest inventory with 3 rows named "&0⚡ Rarezas de Palos Mágicos"
        loop 27 times:
            set slot (loop-value - 1) of {_u} to gray stained glass pane named " "
        loop 6 times:
            set slot (loop-value + 8) of {_u} to getPaloMotivacional(loop-value)
            
        set {_misterio} to wither skeleton skull named "<##330000>&kXX &c&lRANGO DESCONOCIDO &kXX"
        set line 1 of lore of {_misterio} to "<##550000>&l[ ???? ]"
        set line 2 of lore of {_misterio} to ""
        set line 3 of lore of {_misterio} to "&7Este rango es un misterio absoluto."
        set line 4 of lore of {_misterio} to "&7Nadie vivo conoce su verdadera utilidad."
        set line 5 of lore of {_misterio} to ""
        set line 6 of lore of {_misterio} to "&4☠ Haz clic bajo tu propio riesgo..."

        set slot 15 of {_u} to {_misterio} 
        set slot 16 of {_u} to {_misterio} 
        set slot 17 of {_u} to {_misterio} 
        set slot 22 of {_u} to {_misterio} 
        open {_u} to player

on inventory click:
    if name of event-inventory contains "Rarezas de Palos Mágicos":
        cancel event
        if event-inventory is player's inventory:
            stop
        set {_slot} to index of event-slot
        if {_slot} is 15, 16, 17 or 22:
            if player is not op:
                set {_espera} to difference between {motivacion::scare_cd::%uuid of player%} and now
                if {_espera} is less than 45 seconds:
                    set {_restante} to 45 seconds
                    subtract {_espera} from {_restante}
                    send "&c[!] Tu mente aún está perturbada... Espera %{_restante}% para mirar al abismo." to player
                    stop
                set {motivacion::scare_cd::%uuid of player%} to now
            close player's inventory
            if {_slot} is 15:
                send "<##550000>✉ &o""Una risa macabra resuena en tu cabeza... Algo divino se ha podrido.""" to player
                play sound "entity.witch.celebrate" with volume 1.0 and pitch 0.5 at player
                play sound "entity.elder_guardian.ambient" with volume 1.0 and pitch 0.7 at player
                loop 25 times:
                    if player is online:
                        execute console command "execute at %player% run particle minecraft:witch ~ ~2 ~ 0.5 0.5 0.5 0.05 5 normal"
                        wait 4 ticks
            else if {_slot} is 16:
                send "<##8B0000>✉ &o""El aire se vuelve denso. Sientes que un ser mítico cuenta tus pecados.""" to player
                play sound "entity.wither.ambient" with volume 1.0 and pitch 0.4 at player
                play sound "block.respawn_anchor.deplete" with volume 1.0 and pitch 0.5 at player
                loop 25 times:
                    if player is online:
                        execute console command "execute at %player% run particle minecraft:soul ~ ~1 ~ 0.3 0.5 0.3 0.02 4 normal"
                        execute console command "execute at %player% run particle minecraft:large_smoke ~ ~0.1 ~ 0.3 0.1 0.3 0.02 2 normal"
                        wait 4 ticks
            else if {_slot} is 17:
                send "<##33004D>✉ &o""Un latido profundo retumba en tu pecho. Las profundidades te reclaman...""" to player
                play sound "entity.warden.emerge" with volume 1.0 and pitch 0.6 at player
                loop 25 times:
                    if player is online:
                        execute console command "execute at %player% run particle minecraft:sculk_soul ~ ~1 ~ 0.4 0.5 0.4 0.02 6 normal"
                        if loop-value is 1 or 10 or 20:
                            play sound "entity.warden.heartbeat" with volume 1.5 and pitch 0.5 at player
                        wait 4 ticks
            else if {_slot} is 22:
                send title "<##440000>&kXX &c&lERROR CRÍTICO &kXX" with subtitle "<##FF0000>Soberanía Corrupta" to player for 2 seconds
                send "<##FF0000>☠ &l¡EL UNIVERSO SE DESGARRA! Has tocado el poder absoluto... Tu alma tiembla." to player
                play sound "entity.elder_guardian.curse" with volume 1.5 and pitch 0.4 at player
                play sound "ambient.cave" with volume 2 and pitch 0.1 at player
                loop 25 times:
                    if player is online:
                        execute console command "execute at %player% run particle minecraft:dragon_breath ~ ~2 ~ 0.4 0.4 0.4 0.02 8 normal"
                        execute console command "execute at %player% run particle minecraft:damage_indicator ~ ~1 ~ 0.5 0.5 0.5 0.1 5 normal"
                        wait 4 ticks

# ---------------------------------------------------------------------
# PANEL DE ADMINISTRACIÓN (`/palosgui`)
# ---------------------------------------------------------------------
command /palosgui:
    description: Abre el menú de administración para generar Palos Motivacionales.
    permission: op
    permission message: &c[!] No tienes permiso para alterar el destino motivacional.
    trigger:
        set {_gui} to a new chest inventory with 3 rows named "<##FF0055>✦ &lPanel Owner: Palos RGB &r<##FF0055>✦"
        loop 27 times:
            set slot (loop-value - 1) of {_gui} to black stained glass pane named " "
        set slot 4 of {_gui} to nether star named "&e&l🎲 Generador Aleatorio Real 🎲" with lore "" and "&7Genera un palo con el sistema de" and "&7probabilidad exacto de los cofres." and "" and "&a▶ Haz clic para recibir uno"
        loop 9 times:
            set slot (loop-value + 8) of {_gui} to getPaloMotivacional(loop-value)
        set slot 22 of {_gui} to getPaloMotivacional(10)
        open {_gui} to player

on inventory click:
    if name of event-inventory contains "Panel Owner: Palos RGB":
        cancel event
        if event-inventory is not player's inventory:
            set {_slot} to index of event-slot
            if {_slot} is 4:
                set {_i} to getPaloMotivacional(0)
                give {_i} to player
                evaluarYAnunciarPalo(player, {_i})
                play sound "entity.item.pickup" with volume 0.5 at player # FIX MC-107: Corrección de sintaxis
            else if {_slot} is between 9 and 17:
                set {_tier_elegido} to {_slot} - 8
                set {_i} to getPaloMotivacional({_tier_elegido})
                give {_i} to player
                evaluarYAnunciarPalo(player, {_i})
                play sound "entity.item.pickup" with volume 0.5 at player # FIX MC-107: Corrección de sintaxis
            else if {_slot} is 22:
                set {_i} to getPaloMotivacional(10)
                give {_i} to player
                evaluarYAnunciarPalo(player, {_i})
                play sound "entity.item.pickup" with volume 0.5 at player # FIX MC-107: Corrección de sintaxis

command /palosadmin:
    description: Resetea tu Ender Chest y el bloque que estás mirando.
    permission: op
    trigger:
        delete {motivacion::enderchest::%uuid of player%}
        set {_loc} to location of target block
        delete {motivacion::cofres::%{_loc}%}
        delete {motivacion::ignorar::%{_loc}%}
        send "&a✨ [Sistema] Memoria borrada. Tu Ender Chest y el contenedor que miras volverán a dar palo mágico." to player

# ---------------------------------------------------------------------
# INTERACCIÓN DEL CLICK DERECHO (USO DE EFECTOS CON AUDIO 3D)
# ---------------------------------------------------------------------
on right click holding stick:
    set {_nombre} to uncolored name of player's tool
    if {_nombre} contains "Palo" or "Bastón" or "Reliquia" or "Soberanía" or "Vara":
        set {_utilidad} to uncolored line 5 of lore of player's tool
        if {_utilidad} is not set:
            stop
        cancel event
        
        if {_utilidad} contains "Velocidad":
            subtract 1 from item amount of player's tool
            execute console command "effect give %player% minecraft:speed 15 0 true"
            send "&e✨ [Palo] &7¡Subidón de energía! Tienes &fVelocidad I&7."
            play sound "entity.chicken.egg" with volume 1.0 at player
        else if {_utilidad} contains "Prisa":
            subtract 1 from item amount of player's tool
            execute console command "effect give %player% minecraft:haste 20 0 true"
            send "&a✨ [Palo] &7¡Inspiración laboral! Tienes &fPrisa Minera I&7."
            play sound "block.wooden_button.click_on" with volume 1.0 at player
        else if {_utilidad} contains "Visión":
            subtract 1 from item amount of player's tool
            execute console command "effect give %player% minecraft:night_vision 120 0 true"
            send "&9✨ [Palo] &7Tus ojos se adaptan a la oscuridad. &fVisión Nocturna&7."
            play sound "entity.illusioner.prepare_mirror" with volume 1.0 at player
        else if {_utilidad} contains "hambre":
            subtract 1 from item amount of player's tool
            set player's hunger to 20
            set player's saturation to 20
            send "<##A020F0>✨ [Palo] &7Tu alma y tu estómago han sido saciados por completo."
            play sound "entity.player.burp" with volume 1.0 at player
        else if {_utilidad} contains "Fuego":
            subtract 1 from item amount of player's tool
            execute console command "effect give %player% minecraft:fire_resistance 45 0 true"
            send "&6✨ [Palo] &eTu piel se vuelve inmune al calor ardiente. &fAnti-Lava activo&e."
            play sound "item.firecharge.use" with volume 1.0 at player
        else if {_utilidad} contains "Fuerza":
            subtract 1 from item amount of player's tool
            execute console command "effect give %player% minecraft:strength 15 0 true"
            send "<##8B0000>✨ [Palo] &cEl poder de antiguas leyendas corre por tus venas. &fFuerza I&c."
            play sound "entity.zombie_wolf.hurt" with volume 1.0 at player
        else if {_utilidad} contains "Cura":
            subtract 1 from item amount of player's tool
            execute console command "effect clear %player%"
            execute console command "effect give %player% minecraft:absorption 30 0 true"
            send "<##00FFFF>✨ [Palo] &bUna luz divina purifica todas tus maldiciones y toxinas."
            play sound "block.beacon.activate" with volume 1.0 at player
        else if {_utilidad} contains "Regeneración":
            subtract 1 from item amount of player's tool
            execute console command "effect give %player% minecraft:regeneration 8 1 true"
            send "<##FF0055>✨ [Palo] &d¡Desatas un clímax cósmico! Tu salud se restaura velozmente."
            strike lightning effect at player
            play sound "ui.toast.challenge_complete" with volume 1.0 at player
            
        # -------------------------------------------------------------
        # 🔊 EFECTOS GLOBALES ULTRA-PREMIUM (SÓLO LOS DOS MÁS DIFÍCILES)
        # -------------------------------------------------------------
        else if {_utilidad} contains "Océano": # RANGO 9: ABISAL
            subtract 1 from item amount of player's tool
            execute console command "effect give %player% minecraft:water_breathing 60 0 true"
            execute console command "effect give %player% minecraft:dolphins_grace 60 0 true"
            send "<##33004D>✨ [Palo] &5Te vuelves uno con el océano profundo."
            
            # Sonido 3D sónico (Se desvanece a los ~20 bloques de distancia)
            play sound "entity.generic.explode" with volume 1.2 and pitch 0.5 at player
            play sound "entity.dolphin.ambient" with volume 1.5 and pitch 0.8 at player
            
            # Partículas masivas que ven todos los jugadores del servidor cerca
            execute console command "execute at %player% run particle minecraft:sculk_soul ~ ~1 ~ 1 1 1 0.1 120 normal"
            execute console command "execute at %player% run particle minecraft:glow ~ ~1 ~ 1 1 1 0.1 60 normal"
            
        else if {_utilidad} contains "Héroe": # RANGO 10: CELESTIAL (EL MÁXIMO)
            subtract 1 from item amount of player's tool
            execute console command "effect give %player% minecraft:hero_of_the_village 180 0 true"
            send "<##00FFFF>⭐ [Palo] &bEl universo entero te aclama. Los aldeanos te darán ofrendas y descuentos masivos."
            send title "<##00FFFF>&l¡BENDICIÓN CELESTIAL!" with subtitle "&fEl universo está de tu lado" to player for 3 seconds
            
            # Gran Estallido Sónico Final (Se desvanece a los ~25 bloques de distancia)
            play sound "entity.dragon_fireball.explode" with volume 1.5 and pitch 0.4 at player
            play sound "entity.ender_dragon.growl" with volume 1.2 and pitch 1.0 at player
            
            # Show de partículas colosal para todos los presentes
            execute console command "execute at %player% run particle minecraft:explosion_emitter ~ ~1 ~ 0 0 0 0 1 normal"
            execute console command "execute at %player% run particle minecraft:totem_of_undying ~ ~1 ~ 1 2 1 0.4 200 normal"

# ---------------------------------------------------------------------
# DISTRIBUCIÓN AUTOMÁTICA EN TODO CONTENEDOR
# ---------------------------------------------------------------------
on right click:
    if event is canceled:
        stop
        
    # Ender Chest Loot Logic
    if event-block is an ender chest:
        if {motivacion::enderchest::%uuid of player%} is not set:
            set {_item} to getPaloMotivacional(0)
            if player's ender chest has enough space for {_item}:
                set {motivacion::enderchest::%uuid of player%} to true  # FIX MC-106: Bandera movida dentro de la validación de espacio
                add {_item} to player's ender chest
                evaluarYAnunciarPalo(player, {_item})
                play sound "entity.player.levelup" with volume 1.0 at player
        stop
            
    # Regular Container Loot Logic
    set {_tipo} to "%type of event-block%"
    if {_tipo} contains "chest" or "barrel" or "shulker" or "dispenser" or "dropper" or "hopper" or "furnace" or "smoker":
        set {_loc} to location of event-block
        if {motivacion::ignorar::%{_loc}%} is true:
            stop
        if {motivacion::cofres::%{_loc}%} is not set:
            set {_item} to getPaloMotivacional(0)
            if event-block's inventory has enough space for {_item}:
                set {motivacion::cofres::%{_loc}%} to true  # FIX MC-106: Bandera movida dentro de la validación de espacio
                add {_item} to event-block's inventory
                evaluarYAnunciarPalo(player, {_item})
        stop