    send "{@prefix}&cLos 3 objetos no forman una receta válida o falta un Trofeo Élite." to player
    play sound "block.water.ambient" with volume 0.8 and pitch 0.5 at event-location

# ------------------------------------------------------------------------------
# 3. FUNCIONES AUXILIARES DE VALIDACIÓN Y EFECTOS VISUALES (OPTIMIZADO CPU/RAM)
# ------------------------------------------------------------------------------

function nlValidarReceta(items: entities, slot1: object, slot2: object, slot3: object) :: boolean:
    delete {_found1}
    delete {_found2}
    delete {_found3}

    loop {_items::*}:
        set {_e} to loop-value
        set {_item} to item of {_e}
        
        if {_found1} is not set:
            if nlItemCoincide({_item}, {_slot1}) is true:
                set {_found1} to {_e}
                continue

        if {_found2} is not set:
            if nlItemCoincide({_item}, {_slot2}) is true:
                set {_found2} to {_e}
                continue

        if {_found3} is not set:
            if nlItemCoincide({_item}, {_slot3}) is true:
                set {_found3} to {_e}
                continue

    if {_found1} is set:
        if {_found2} is set:
            if {_found3} is set:
                return true
    return false

function nlItemCoincide(it: item, target: object) :: boolean:
    if {_target} is a text:
        if name of {_it} contains {_target}:
            return true
    else if {_target} is an item type:
        if type of {_it} is {_target}:
            if name of {_it} is not set:
                return true
            else if name of {_it} does not contain "Trofeo":
                return true
    return false

function nlConsumir(items: entities, target: object):
    loop {_items::*}:
        set {_e} to loop-value
        set {_it} to item of {_e}
        if nlItemCoincide({_it}, {_target}) is true:
            set {_amt} to item amount of {_it}
            if {_amt} <= 1:
                kill {_e}
            else:
                remove 1 from item amount of {_it}
                set item of {_e} to {_it}
            stop

function nlProcesarAlquimia(p: player, caldero: block, pocion: item, rayos: number, titulo: text, subtitulo: text, items: entities, i1: object, i2: object, i3: object):
    add hide additional tooltip to item flags of {_pocion}
    add hide attributes to item flags of {_pocion}

    nlConsumir({_items::*}, {_i1})
    nlConsumir({_items::*}, {_i2})
    nlConsumir({_items::*}, {_i3})

    remove 1 of glass bottle from {_p}'s tool
    set {_caldero} to cauldron

    if {_p}'s inventory has space for {_pocion}:
        give {_pocion} to {_p}
    else:
        drop {_pocion} at location of {_p}

    # Sistema visual progresivo y optimizado (Pausado cada 2 ticks para cuidar CPU/RAM)
    set {_cantidad} to {_rayos} * 4
    loop 4 times:
        make {_cantidad} of splash at location of {_caldero}
        make ({_cantidad} / 2) of smoke at location of {_caldero}
        if {_rayos} >= 6:
            make 10 of soul fire flame at location of {_caldero}
        wait 2 ticks

    loop {_rayos} times:
        strike lightning effect at location of {_caldero}
        if {_rayos} >= 8:
            make 12 of totem of undying at location of {_caldero}
        wait 2 ticks

    send title {_titulo} with subtitle {_subtitulo} to {_p} for 3 seconds
    play sound "entity.player.levelup" with volume 0.8 and pitch 1.2 to {_p}

