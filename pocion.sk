# ==============================================================================
#   🧪 NATURELAND | ALQUIMIA ELITE & ANCESTRAL (19 RECETAS HARDCORE + COOLDOWN)
#   REQUISITOS: Trofeos de Mobs Élites + Minerales Avanzados + Pistas en Cadena
#   COMPATIBILIDAD: PaperMC 1.21.1 + SkBee 3.25.1 (0% Lore Sucio / Sin efectos)
# ==============================================================================

options:
    prefix: &8[&6&lALQUIMIA&8] &r

# ------------------------------------------------------------------------------
# 1. GUÍA /POCIONES
# ------------------------------------------------------------------------------
command /pociones:
    aliases: /alquimia, /recetas
    trigger:
        if player's world is not "world":
            send "{@prefix}&cLa alquimia solo funciona en el mundo principal (&eworld&c)." to player
            stop
        
        set {_gui} to a new chest inventory with 3 rows named "&8🧪 &6&lALQUIMIA ELITE &8| &0Guía"
        loop 27 times:
            set slot (loop-number - 1) of {_gui} to black stained glass pane named " "
            
        # Pista visible: Receta #1 (Hardcore)
        set {_pista1} to water bottle named "&6&l[Pista #1] Té de Zanahoria Mística" with lore "", "&7Infusión inicial de alta eficiencia.", "", "&e&lIngredientes requeridos:", "&f  • 1x Trofeo Elite Tier 2", "&f  • 1x Bloque de Hierro" and "&f  • 1x Amatista"
        apply potion contents to {_pista1}:
            custom_color: rgb(50, 150, 255)
        add hide additional tooltip to item flags of {_pista1}
        add hide attributes to item flags of {_pista1}
        set slot 10 of {_gui} to {_pista1}
        
        # Pista de recetas secretas
        set slot 13 of {_gui} to purple glazed terracotta named "&d&l❓ CADENA DE 19 RECETAS" with lore "", "&7¡Cada poción que crees tendrá en su Lore", "&7la pista secreta para fabricar la siguiente!", "" and "&d• Requiere Trofeos T2, T3, T4, T5 y Estrellas del Nether."
        
        # Instrucciones
        set slot 16 of {_gui} to book named "&e&l📖 INSTRUCCIONES" with lore "", "&61. &fLlena el caldero con &bAgua&f.", "&62. &fPon una &eFogata encendida &fdebajo.", "&63. &fLanza los &a3 ingredientes requeridos&f." and "&64. &fHaz Clic Derecho con un &bFrasco de Cristal&f."

        open {_gui} to player

on inventory click:
    if name of event-inventory contains "ALQUIMIA":
        cancel event

# ------------------------------------------------------------------------------
# 2. SISTEMA DE DESTILACIÓN (19 RECETAS EN CADENA + COOLDOWN ANTI-LAG)
# ------------------------------------------------------------------------------
on right click on cauldron or water cauldron:
    if player's world is not "world":
        stop
    if player's tool is not glass bottle:
        stop

    if event-block is not water cauldron:
        send "{@prefix}&cEl caldero debe contener &bAgua &cpara alquimia." to player
        play sound "block.water.ambient" with volume 0.8 and pitch 0.5 at event-location
        stop

    set {_bloque_abajo} to type of block below event-block
    if "%{_bloque_abajo}%" does not contain "campfire":
        send "{@prefix}&cEl caldero está frío... Pon una &efogata encendida &cdebajo." to player
        play sound "block.fire.extinguish" with volume 0.5 and pitch 1.0 at event-location
        stop

    # Cooldown Anti-Spam para proteger CPU/RAM (OPs exentos)
    if player is not op:
        set {_waited} to difference between {nl::cooldown::alquimia::%uuid of player%} and now
        if {_waited} is less than 4 seconds:
            set {_rem} to difference between 4 seconds and {_waited}
            send action bar "{@prefix}&c⏳ El caldero está reaccionando... Espera &e%{_rem}%&c." to player
            play sound "entity.enderman.teleport" with volume 0.5 and pitch 0.5 at event-location
            stop
        set {nl::cooldown::alquimia::%uuid of player%} to now

    cancel event

    # Entidades arrojadas en el caldero
    set {_items::*} to dropped items in radius 1.5 around event-block

    # ==========================================================================
    # RECETAS TIER 2 (Pociones 1 a 4)
    # ==========================================================================
    
    # R1 -> Pista para R2 (Color: Azul Místico)
    if nlValidarReceta({_items::*}, "Trofeo Elite Tier 2", iron block, amethyst shard) is true:
        set {_p} to water bottle named "&6&lTé de Zanahoria Mística" with lore "&8[Receta #1]", "", "&e• Efectos:", "&f  - Prisa Minera II (3m)", "&f  - Visión Nocturna (5m)", "", "&6&l💡 PISTA RECETA #2:" and "&7""Fuego abisal: Trofeo T2, Bloque Magma y Crema Magma"""
        apply potion contents to {_p}:
            custom_color: rgb(50, 150, 255)
        add hide additional tooltip to item flags of {_p}
        add hide attributes to item flags of {_p}
        nlProcesarAlquimia(player, event-block, {_p}, 1, "&6&lTÉ MÍSTICO", "&eInfusión Élite #1", {_items::*}, "Trofeo Elite Tier 2", iron block, amethyst shard)
        stop

    # R2 -> Pista para R3 (Color: Naranja Fuego)
    if nlValidarReceta({_items::*}, "Trofeo Elite Tier 2", magma block, magma cream) is true:
        set {_p} to water bottle named "&4&lElixir de Fuego Infernal" with lore "&8[Receta #2]", "", "&e• Efectos:", "&f  - Fuerza II (3m)", "&f  - Resistencia al Fuego (8m)", "", "&6&l💡 PISTA RECETA #3:" and "&7""Energía roja: Trofeo T2, Bloque Redstone y Zanahoria Oro"""
        apply potion contents to {_p}:
            custom_color: rgb(255, 100, 0)
        add hide additional tooltip to item flags of {_p}
        add hide attributes to item flags of {_p}
        nlProcesarAlquimia(player, event-block, {_p}, 1, "&4&lFUEGO INFERNAL", "&cPoder Abisal #2", {_items::*}, "Trofeo Elite Tier 2", magma block, magma cream)
        stop

    # R3 -> Pista para R4 (Color: Celeste Veloz)
    if nlValidarReceta({_items::*}, "Trofeo Elite Tier 2", redstone block, golden carrot) is true:
        set {_p} to water bottle named "&c&lBrebaje del Corredor" with lore "&8[Receta #3]", "", "&e• Efectos:", "&f  - Velocidad II (5m)", "&f  - Prisa II (3m)", "", "&6&l💡 PISTA RECETA #4:" and "&7""Destello dorado: Trofeo T2, Bloque de Oro y Sandía Reluciente"""
        apply potion contents to {_p}:
            custom_color: rgb(100, 220, 255)
        add hide additional tooltip to item flags of {_p}
        add hide attributes to item flags of {_p}
        nlProcesarAlquimia(player, event-block, {_p}, 1, "&c&lCORREDOR", "&eInfusión Élite #3", {_items::*}, "Trofeo Elite Tier 2", redstone block, golden carrot)
        stop

    # R4 -> Pista para R5 (Color: Rojo Carmesí)
    if nlValidarReceta({_items::*}, "Trofeo Elite Tier 2", gold block, glistering melon slice) is true:
        set {_p} to water bottle named "&e&lTónico de Curación Real" with lore "&8[Receta #4]", "", "&e• Efectos:", "&f  - Regeneración II (3m)", "&f  - Absorción II (3m)", "", "&6&l💡 PISTA RECETA #5:" and "&7""Rey Sombrío: Trofeo Real T3, Bloque de Oro y Rosa Wither"""
