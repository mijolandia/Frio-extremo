    # R19 (TIER 20 HARDCORE DEFINITIVO) -> Color: Rojo Carmesí Legendario
    if nlValidarReceta({_items::*}, "Trofeo Cataclismo Tier 5", netherite block, nether star) is true:
        set {_p} to water bottle named "&4&l⚡ DESTRUCTOR DE MUNDOS ⚡" with lore "&c&l[RECETA SUPREMA #19]", "", "&7El elixir más difícil de la historia.", "", "&e• Efectos Legendarios:", "&f  - Absorción V (5m)", "&f  - Regeneración IV (5m)", "&f  - Fuerza IV (5m)", "&f  - Resistencia III (5m)" and "&f  - Prisa III (5m)"
        apply potion contents to {_p}:
            custom_color: rgb(255, 30, 0)
        add hide additional tooltip to item flags of {_p}
        add hide attributes to item flags of {_p}
        nlProcesarAlquimia(player, event-block, {_p}, 10, "&4&l⚡ DESTRUCTOR DE MUNDOS ⚡", "&6Alquimia Legendaria Completada", {_items::*}, "Trofeo Cataclismo Tier 5", netherite block, nether star)
