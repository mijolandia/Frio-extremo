# ==============================================================================
#   🏆 MENÚ DE ADMINISTRACIÓN Y GENERADOR DE TROFEOS (GUI)
#   COMANDOS: /guitrofeos | /dartrofeos | /trofeosadmin
#   REQUERIMIENTO: Permisos de operador (OP)
# ==============================================================================

command /win:
    aliases: /dartrofeos, /trofeosadmin
    permission: op
    permission message: &c&l[!] &cNo tienes permisos de OP para abrir este menú.
    trigger:
        set {_gui} to a new chest inventory with 3 rows named "&8🏆 &6&lPANEL DE TROFEOS &8| &7Admin"
        
        loop 27 times:
            set slot (loop-number - 1) of {_gui} to black stained glass pane named " "

        set {_t2} to golden carrot named "&6&lTrofeo Elite Tier 2"
        set lore of {_t2} to "&7Emblema legendario obtenido al derrotar" and "&7a un monstruo &cTier 2&7 en world." and "" and "&e• Valor Base: &a$250.00" and "&e• Rareza: &6Muy Alta" and "" and "&a▶ Clic Izquierdo: &fDar 1 trofeo" and "&a▶ Clic Derecho: &fDar 64 trofeos"
        set slot 10 of {_gui} to {_t2}

        set {_t3} to golden carrot named "&e&l👑 Trofeo Real Tier 3"
        set lore of {_t3} to "&7Emblema legendario obtenido al derrotar" and "&7a un monstruo &cTier 3&7 en world." and "" and "&e• Valor Base: &a$600.00" and "&e• Rareza: &6Muy Alta" and "" and "&a▶ Clic Izquierdo: &fDar 1 trofeo" and "&a▶ Clic Derecho: &fDar 64 trofeos"
        set slot 12 of {_gui} to {_t3}

        set {_t4} to golden carrot named "&4&l☠ Trofeo Abisal Tier 4"
        set lore of {_t4} to "&7Emblema legendario obtenido al derrotar" and "&7a un monstruo &cTier 4&7 en world." and "" and "&e• Valor Base: &a$1500.00" and "&e• Rareza: &6Muy Alta" and "" and "&a▶ Clic Izquierdo: &fDar 1 trofeo" and "&a▶ Clic Derecho: &fDar 64 trofeos"
        set slot 14 of {_gui} to {_t4}

        set {_t5} to golden carrot named "&5&l⚡ Trofeo Cataclismo Tier 5"
        set lore of {_t5} to "&7Emblema legendario obtenido al derrotar" and "&7a un monstruo &cTier 5&7 en world." and "" and "&e• Valor Base: &a$4000.00" and "&e• Rareza: &6Muy Alta" and "" and "&a▶ Clic Izquierdo: &fDar 1 trofeo" and "&a▶ Clic Derecho: &fDar 64 trofeos"
        set slot 16 of {_gui} to {_t5}

        open {_gui} to player

on inventory click:
    if name of event-inventory contains "PANEL DE TROFEOS":
        cancel event
        if clicked slot is 10, 12, 14 or 16:
            set {_cant} to 1
            if click type is right mouse button or right mouse button with shift:
                set {_cant} to 64
            
            if clicked slot is 10:
                set {_item} to golden carrot named "&6&lTrofeo Elite Tier 2"
                set lore of {_item} to "&7Emblema legendario obtenido al derrotar" and "&7a un monstruo &cTier 2&7 en world." and "" and "&e• Valor Base: &a$250.00" and "&e• Rareza: &6Muy Alta" and "" and "&a▶ Véndelo en /trofeos (Clic en Mercado)"
            else if clicked slot is 12:
                set {_item} to golden carrot named "&e&l👑 Trofeo Real Tier 3"
                set lore of {_item} to "&7Emblema legendario obtenido al derrotar" and "&7a un monstruo &cTier 3&7 en world." and "" and "&e• Valor Base: &a$600.00" and "&e• Rareza: &6Muy Alta" and "" and "&a▶ Véndelo en /trofeos (Clic en Mercado)"
            else if clicked slot is 14:
                set {_item} to golden carrot named "&4&l☠ Trofeo Abisal Tier 4"
                set lore of {_item} to "&7Emblema legendario obtenido al derrotar" and "&7a un monstruo &cTier 4&7 en world." and "" and "&e• Valor Base: &a$1500.00" and "&e• Rareza: &6Muy Alta" and "" and "&a▶ Véndelo en /trofeos (Clic en Mercado)"
            else if clicked slot is 16:
                set {_item} to golden carrot named "&5&l⚡ Trofeo Cataclismo Tier 5"
                set lore of {_item} to "&7Emblema legendario obtenido al derrotar" and "&7a un monstruo &cTier 5&7 en world." and "" and "&e• Valor Base: &a$4000.00" and "&e• Rareza: &6Muy Alta" and "" and "&a▶ Véndelo en /trofeos (Clic en Mercado)"
            
            give {_cant} of {_item} to player
            play sound "entity.item.pickup" with volume 1 and pitch 1.2 to player
            send "&a&l[!] &fObtuviste &e%{_cant}%x &f%name of {_item}%&f." to player